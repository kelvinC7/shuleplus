NODE_ENV=development
PORT=3064
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transport_db
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32chars
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3065
MODULE_SLUG=transport
IAM_API_URL=http://localhost:3001/api/v1

# Open map stack (no vendor API keys). Point to self-hosted services in production.
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim policy: identifiable User-Agent with contact email
MAP_HTTP_USER_AGENT=ShulePlus-Transport/1.0 (contact: transport-admin@your-school.rw)
MAP_GEOCODING_COUNTRY=rw
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
# Must match Parent MIS Backend PORT + API_PREFIX (default http://localhost:3048/api)
PARENT_MIS_API_URL=http://localhost:3048/api
INTERNAL_CHAT_API_URL=http://localhost:3055/api
NOTIFICATION_SERVICE_URL=http://localhost:3001/api/v1/notifications
NOTIFICATION_SERVICE_API_KEY=dev-service-key
