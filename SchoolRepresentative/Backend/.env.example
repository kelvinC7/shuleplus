# ── Service ─────────────────────────────────────────────
PORT=3080
API_PREFIX=/api/director
NODE_ENV=development

# ── Shared platform secrets (must match IAM) ───────────
# Same value as IAM JWT_ACCESS_SECRET - the console verifies
# IAM-issued access tokens with this secret.
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32chars
# Same value as IAM MODULE_PROVISIONING_KEY (service-to-service)
SERVICE_API_KEY=dev-service-key

# ── Console database (SQLite) ──────────────────────────
# Stores approvals inbox, decisions, action-plan tasks,
# broadcasts, notifications, audit trail and incidents.
DATABASE_URL="file:./director-console.db"

# ── Upstream services ──────────────────────────────────
IAM_API_URL=http://localhost:3001/api/v1

# ── Modes ──────────────────────────────────────────────
# ALLOW_DEMO=true lets the portal render with a seeded demo
# dataset (clearly labelled in the UI) when no IAM token is
# present. Set to false once the module is registered in IAM.
ALLOW_DEMO=true

# ── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3081
