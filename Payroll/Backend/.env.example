NODE_ENV=development
PORT=3026
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payroll_module_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3008
MODULE_SLUG=payroll
HR_API_URL=http://localhost:3005/api
# Set to false when HR backend is not running (avoids ECONNREFUSED noise in dev)
HR_INTEGRATION_ENABLED=false
# KaziAdvance — advance deductions when running payroll
KAZI_API_URL=http://localhost:4400
KAZI_INTEGRATION_ENABLED=false
IAM_API_URL=http://localhost:3001/api/v1
TEACHER_PORTAL_URL=http://localhost:3009
