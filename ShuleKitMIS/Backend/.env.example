NODE_ENV=development
PORT=3038
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shulekit_mis_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
# Must match IAM PLATFORM_SERVICE_KEY / MODULE_PROVISIONING_KEY
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
# Master-data source for students + parents (Student Management module)
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
# Babyeyi NESA circulars (service-auth)
BABYEYI_API_URL=http://localhost:3012/api
# IAM (optional district/school listings)
IAM_API_URL=http://localhost:3001/api/v1
# Flat fee charged when a kit is delivered home
HOME_DELIVERY_FEE=2500
CORS_ORIGIN=http://localhost:3039,http://localhost:3000
MODULE_SLUG=shulekit-mis

# ── Production (materials.shuleplus.rw) ─────────────────────────────────────
# NODE_ENV=production
# PORT=4021
# STUDENT_MANAGEMENT_API_URL=https://studentmanagement-api.shuleplus.rw/api
