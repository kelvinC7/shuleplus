generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ConversationType {
  DIRECT
  GROUP
  DEPARTMENT
  ANNOUNCEMENT
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum ChatMemberKind {
  STAFF
  PARENT
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

model Tenant {
  id               String       @id @default(uuid())
  organizationId   String       @unique @map("organization_id")
  organizationCode String?      @map("organization_code")
  organizationName String       @map("organization_name")
  status           TenantStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  conversations Conversation[]
  messages      Message[]
  members       ChatMember[]

  @@map("tenants")
}

model ChatMember {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  userId         String          @map("user_id")
  kind           ChatMemberKind  @default(STAFF) @map("kind")
  email          String
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  phone          String?
  avatarUrl      String?         @map("avatar_url")
  department     String?         @map("department")
  position       String?         @map("position")
  source         String?         @default("iam")
  hasAccount     Boolean         @default(false) @map("has_account")
  roleSlugs      Json?           @map("role_slugs")
  lastSeenAt     DateTime?       @map("last_seen_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [organizationId], references: [organizationId])
  memberships ConversationMember[]

  @@unique([organizationId, userId])
  @@index([organizationId, department])
  @@index([organizationId, kind])
  @@index([organizationId, source])
  @@map("chat_members")
}

model Conversation {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  type           ConversationType @default(DIRECT)
  name           String?
  department     String?
  description    String?
  createdById    String           @map("created_by_id")
  lastMessageAt  DateTime?        @map("last_message_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [organizationId], references: [organizationId])
  members  ConversationMember[]
  messages Message[]

  @@index([organizationId, type])
  @@index([organizationId, department])
  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id                String        @id @default(uuid())
  conversationId    String        @map("conversation_id")
  organizationId    String        @map("organization_id")
  userId            String        @map("user_id")
  role              MemberRole    @default(MEMBER)
  mutedAt           DateTime?     @map("muted_at")
  lastReadAt        DateTime?     @map("last_read_at")
  lastReadMessageId String?       @map("last_read_message_id")
  joinedAt          DateTime      @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  member      ChatMember   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id               String      @id @default(uuid())
  conversationId   String      @map("conversation_id")
  organizationId   String      @map("organization_id")
  senderId         String      @map("sender_id")
  type             MessageType @default(TEXT)
  body             String?
  attachmentUrl    String?     @map("attachment_url")
  attachmentName   String?     @map("attachment_name")
  attachmentMime   String?     @map("attachment_mime")
  attachmentSize   Int?        @map("attachment_size")
  editedAt         DateTime?   @map("edited_at")
  deletedAt        DateTime?   @map("deleted_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant       Tenant       @relation(fields: [organizationId], references: [organizationId])

  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@index([organizationId])
  @@map("messages")
}
