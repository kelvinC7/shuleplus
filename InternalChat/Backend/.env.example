NODE_ENV=development
PORT=3055
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_module_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
# Must match IAM PLATFORM_SERVICE_KEY / MODULE_PROVISIONING_KEY
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
# IAM for org member directory (service-to-service, internal endpoints)
IAM_API_URL=http://localhost:3001/api/v1
# Allow the module frontend + IAM landing
CORS_ORIGIN=http://localhost:3054,http://localhost:3000,capacitor://localhost,ionic://localhost,https://localhost,http://localhost,https://parents.shuleplus.rw
MODULE_SLUG=chat
# Attachment size cap (bytes)
MAX_ATTACHMENT_BYTES=10485760

# ── Production (shulechat.shuleplus.rw / shulechat-api.shuleplus.rw) ───────
# NODE_ENV=production
# PORT=4029
# IAM_API_URL=http://localhost:4001/api/v1
# CORS_ORIGIN=https://shulechat.shuleplus.rw,https://shulechat-api.shuleplus.rw,https://shuleplus.rw,https://app.shuleplus.rw
