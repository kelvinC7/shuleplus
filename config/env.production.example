# ShulePlus production URLs (base domain: shuleplus.rw)
# Full registry: config/subdomains.json (29 IAM module slugs)
# Apply to database: npm run subdomains:apply

# ── Platform ───────────────────────────────────────────────────────────────
# Marketing     https://shuleplus.rw
# IAM app       https://app.shuleplus.rw
# IAM API       https://api.shuleplus.rw
# Notifications https://notifications-api.shuleplus.rw

# ── Pattern ────────────────────────────────────────────────────────────────
# Module UI:  https://{subdomain}.shuleplus.rw
# Module API: https://{subdomain}-api.shuleplus.rw

# ── Education & people (22 marketplace + platform modules) ───────────────────
# academic          academic.shuleplus.rw
# teachers          teachers.shuleplus.rw          (teacher-portal)
# fees              fees.shuleplus.rw              (school-fees)
# finance           finance.shuleplus.rw
# budget            budget.shuleplus.rw            (school-budget)
# payroll           payroll.shuleplus.rw
# hr                hr.shuleplus.rw
# attendance        attendance.shuleplus.rw
# leave             leave.shuleplus.rw
# teachers          teachers.shuleplus.rw
# discipline        discipline.shuleplus.rw        (student-discipline)
# parents           parents.shuleplus.rw           (parent-mis)
# timetable         timetable.shuleplus.rw
# library           library.shuleplus.rw

# ── Operations & finance ─────────────────────────────────────────────────────
# procurement       procurement.shuleplus.rw
# inventory         inventory.shuleplus.rw
# uniform           uniform.shuleplus.rw           (school-uniform)
# assets            assets.shuleplus.rw
# transport         transport.shuleplus.rw
# canteen           canteen.shuleplus.rw           (canteen + cafeteria)
# materials         materials.shuleplus.rw         (schoolmaterial + shulekit-mis / ShuleKit)
# action-plan       action-plan.shuleplus.rw
# tasks             tasks.shuleplus.rw             (task-module)

# ── Intelligence & governance ────────────────────────────────────────────────
# website           website.shuleplus.rw           (mini-website)
# dashboard         dashboard.shuleplus.rw
# circulars         circulars.shuleplus.rw
# nesa              nesa.shuleplus.rw
# babyeyi           babyeyi.shuleplus.rw
# kazi              kazi.shuleplus.rw              (kaziavance)
# demo              demo.shuleplus.rw              (sample-module)

# ── Landing / Auth .env.production (ShuleKit) ───────────────────────────────
# NEXT_PUBLIC_SHULEKIT_URL=https://materials.shuleplus.rw
# NEXT_PUBLIC_SHULEKIT_API_URL=https://materials-api.shuleplus.rw/api

# ── Module frontend .env.production template ───────────────────────────────
# NEXT_PUBLIC_IAM_URL=https://app.shuleplus.rw
# NEXT_PUBLIC_IAM_API_URL=https://api.shuleplus.rw/api/v1
# NEXT_PUBLIC_API_URL=https://{subdomain}-api.shuleplus.rw/api
# CORS_ORIGIN=https://{subdomain}.shuleplus.rw,https://app.shuleplus.rw
