NODE_ENV=development
PORT=3076
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shule_trip_db
# Must match Authentication/Backend JWT_ACCESS_SECRET exactly
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3077,http://localhost:3000
MODULE_SLUG=shule-trip
IAM_API_URL=http://localhost:3001/api/v1
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
GOVERNMENT_ROLES=super_admin,national_administrator,intake_reviewer,education_reviewer,transport_reviewer,checkpoint_inspector,final_approval_officer,monitoring_officer,district_education_officer,sector_education_inspector,organization_admin
# Same pattern as Transport/SectorMIS — enables real registration emails
NOTIFICATION_SERVICE_URL=http://localhost:4001/api/v1/notifications
NOTIFICATION_SERVICE_API_KEY=dev-service-key
SHULETRIP_PUBLIC_LOGIN_URL=http://localhost:3077/login
