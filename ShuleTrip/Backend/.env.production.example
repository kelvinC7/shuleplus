NODE_ENV=production
PORT=4033
API_PREFIX=/api
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shule_trip_db?connection_limit=2
JWT_ACCESS_SECRET=
PLATFORM_SERVICE_KEY=
SERVICE_API_KEY=
CORS_ORIGIN=https://shuletrip.shuleplus.rw,https://shuletrip-api.shuleplus.rw,https://shuleplus.rw,https://app.shuleplus.rw,https://www.shuleplus.rw
MODULE_SLUG=shule-trip
IAM_API_URL=http://localhost:4001/api/v1
STUDENT_MANAGEMENT_API_URL=http://localhost:4024/api
GOVERNMENT_ROLES=super_admin,national_administrator,intake_reviewer,education_reviewer,transport_reviewer,checkpoint_inspector,final_approval_officer,monitoring_officer,district_education_officer,sector_education_inspector,organization_admin
