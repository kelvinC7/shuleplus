# Leave VITE_API_URL empty: browser calls /api; Vite proxies (see vite.config.js).
# /api/teacher-portal and /tp-api → TichaPortal backend :4000
# TichaPortal backend fetches Timetable :3010, Student Management :3052,
# Academic :3003, Attendance :3024 (not TeacherPortal :3009)
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:4000
VITE_IAM_API_URL=http://localhost:3001/api/v1
VITE_KAZI_API_URL=http://localhost:4400
VITE_TP_API_URL=
VITE_TP_PROXY_TARGET=http://localhost:4000
