# TichaPortal frontend — local development
# Leave VITE_API_URL / VITE_TP_API_URL empty so Vite proxies to the BFF.

VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:4000
VITE_IAM_API_URL=http://localhost:3001/api/v1
VITE_KAZI_API_URL=http://localhost:4400
VITE_TP_API_URL=
VITE_TP_PROXY_TARGET=http://localhost:4000
# ParentMIS real-time chat (optional; default http://localhost:3048)
VITE_PARENT_MIS_SOCKET_URL=http://localhost:3048

