NODE_ENV=development
PORT=3093
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/print_card_module_db
# Must match Authentication/Backend JWT_ACCESS_SECRET exactly
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3092
MODULE_SLUG=print-card
IAM_API_URL=http://localhost:3001/api/v1
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
HR_API_URL=http://localhost:3005/api
TIMETABLE_API_URL=http://localhost:3010/api
# Photo import disk root (production: /var/www/shuleplus/imports)
IMPORT_ROOT=./imports
PHOTO_IMPORT_CONCURRENCY=3
# Staging Excel/ZIP are deleted right after upload completes (or analyze fails).
PHOTO_IMPORT_ZIP_RETENTION_DAYS=0
