NODE_ENV=development
PORT=3052
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_management_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
# Must match IAM PLATFORM_SERVICE_KEY / MODULE_PROVISIONING_KEY
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
# Include Capacitor origins — yoShule Parent APK calls /public/parents/auth/* from https://localhost
CORS_ORIGIN=http://localhost:3053,http://localhost:3000,http://localhost:3039,capacitor://localhost,ionic://localhost,https://localhost,http://localhost,https://parents.shuleplus.rw
MODULE_SLUG=student-management
IAM_API_URL=http://localhost:4001/api/v1
TIMETABLE_API_URL=http://localhost:4014/api
HR_API_URL=http://localhost:4007/api
# Public URL for uploaded files (/uploads/...) returned in API responses
PUBLIC_BASE_URL=https://studentmanagement-api.shuleplus.rw
