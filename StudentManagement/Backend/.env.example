NODE_ENV=development
PORT=3052
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_management_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
# Must match IAM PLATFORM_SERVICE_KEY / MODULE_PROVISIONING_KEY
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3053,http://localhost:3000,http://localhost:3039
MODULE_SLUG=student-management
# Public URL for uploaded files (/uploads/...) returned in API responses
PUBLIC_BASE_URL=https://studentmanagement-api.shuleplus.rw
