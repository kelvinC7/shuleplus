NODE_ENV=production
PORT=3094
API_PREFIX=/api
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shuleplus_curriculum?schema=public
JWT_ACCESS_SECRET=change-me-min-64-chars-use-secrets-manager
SERVICE_API_KEY=rotate-me-match-iam-module-key
CORS_ORIGIN=https://ticha.shuleplus.rw,https://portal.shuleplus.rw

# ——— Production AI (Azure OpenAI only — enterprise SLA, private networking) ———
AI_PROVIDER=azure_openai
TEACHER_AI_ENABLED=true
AI_DAILY_LIMIT_PER_TEACHER=40
AI_DAILY_LIMIT_PER_ORGANIZATION=2000
AI_BILLING_MODE=prepaid

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=from-azure-portal-or-key-vault
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Do NOT set Groq/Gemini in production — ignored when NODE_ENV=production

UPLOAD_DIR=./uploads/curriculum
PYTHON_BIN=python
PDF_EXTRACT_SCRIPT=../worker/extract_pdf.py
