NODE_ENV=development
PORT=3094
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shuleplus_curriculum?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32chars
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
MODULE_SLUG=curriculum-intelligence
UPLOAD_DIR=./uploads/curriculum
# --- AI (server-side only — see ../docs/AI-PROVIDERS.md) ---
AI_PROVIDER=auto
# Production (secure): Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Free tier pilot: Groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Free tier: Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Local free: Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
PYTHON_BIN=python
PDF_EXTRACT_SCRIPT=../worker/extract_pdf.py
OCR_ENABLED=true
# Optional — async extraction for large PDFs (falls back to inline processing)
# REDIS_URL=redis://localhost:6379
# SEED_PILOT_CURRICULUM=false
