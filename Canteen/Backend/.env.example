MODULE_SLUG=canteen
# Cross-module integration
ACADEMIC_API_URL=http://localhost:3003/api
IAM_API_URL=http://localhost:3001/api/v1
IAM_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3051
