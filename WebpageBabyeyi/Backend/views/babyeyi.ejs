<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Get Babyeyi</title>
    <style>
      body{font-family:Arial,Helvetica,sans-serif;background:#f6f8fb;padding:24px}
      .card{max-width:760px;margin:24px auto;background:#fff;padding:20px;border-radius:10px;box-shadow:0 6px 20px rgba(2,6,23,0.06)}
      label{display:block;margin-bottom:6px;font-weight:700;color:#334155}
      input,select{width:100%;padding:10px;border-radius:8px;border:1px solid #e6eef6}
      button{background:#0ea5e9;color:#fff;border:none;padding:10px 14px;border-radius:8px;font-weight:700}
      .muted{color:#64748b}
      .error{background:#fce7f3;padding:10px;border-radius:8px;color:#9f1239}
      .student{margin-top:12px;padding:12px;background:#f1f8ff;border-radius:8px}
    </style>
  </head>
  <body>
    <div class="card">
      <h2>Get Babyeyi</h2>
      <p class="muted">Enter student code (SDMS) to look up their info and available circulars.</p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="post" action="/babyeyi/lookup">
        <label for="code">Student code (SDMS)</label>
        <input id="code" name="code" type="text" placeholder="e.g. 04001042426" />
        <div style="height:12px"></div>
        <button type="submit">Lookup</button>
      </form>

      <% if (student) { %>
        <div class="student">
          <strong><%= student.fullName %></strong>
          <div class="muted"><%= student.schoolName %> · <%= student.className %></div>
          <div style="margin-top:8px">
            <strong>Organization ID:</strong> <%= student.organizationId %>
          </div>
        </div>
      <% } %>

      <% if (circulars && circulars.length > 0) { %>
        <div style="margin-top:12px">
          <h3>Available periods</h3>
          <ul>
            <% circulars.forEach(function(c){ %>
              <li><strong><%= c.academicYear %></strong> — <%= (c.terms||[]).join(', ') %></li>
            <% }) %>
          </ul>
        </div>
      <% } else if (student) { %>
        <div style="margin-top:12px" class="muted">No circulars found for this school.</div>
      <% } %>

    </div>
  </body>
</html>
