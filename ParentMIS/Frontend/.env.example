# ParentMIS Frontend environment
# Local development defaults (override for production)
NEXT_PUBLIC_API_URL=http://localhost:3048/api
# Optional; defaults to API host without /api
NEXT_PUBLIC_PARENT_MIS_SOCKET_URL=http://localhost:3048
NEXT_PUBLIC_IAM_URL=http://localhost:3000
NEXT_PUBLIC_IAM_API_URL=http://localhost:3001/api/v1

# Student Management / ShuleKit
NEXT_PUBLIC_STUDENT_MGMT_API_URL=http://localhost:3052/api
NEXT_PUBLIC_SHULEKIT_API_URL=https://materials-api.shuleplus.rw/api

# Public find-child: fees lines + Babyeyi (optional; lookup still works without them)
NEXT_PUBLIC_SCHOOL_FEES_API_URL=http://localhost:3014/api
NEXT_PUBLIC_BABYEYI_API_URL=http://localhost:3012/api

# Fees portal UI (receipts QR)
NEXT_PUBLIC_FEES_PORTAL_URL=http://localhost:3015

# Firebase Web Push / FCM client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_APP_VERSION=1.0.0

# Welcome page — mobile app & training (YouTube video IDs without URL prefix)
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PARENT_APK_URL=/downloads/yoshule-parent.apk
NEXT_PUBLIC_VIDEO_PAY_FEES=
NEXT_PUBLIC_VIDEO_BABYEYI=
NEXT_PUBLIC_VIDEO_CONSOLE=

# Production example values:
# NEXT_PUBLIC_API_URL=https://parents.shuleplus.rw/api
# NEXT_PUBLIC_PARENT_MIS_SOCKET_URL=https://parents.shuleplus.rw
# NEXT_PUBLIC_IAM_URL=https://app.shuleplus.rw
# NEXT_PUBLIC_IAM_API_URL=https://shuleplus.rw/api/v1
# NEXT_PUBLIC_STUDENT_MGMT_API_URL=https://studentmanagement-api.shuleplus.rw/api
# NEXT_PUBLIC_FEES_PORTAL_URL=https://fees.shuleplus.rw
# NEXT_PUBLIC_SHULEKIT_API_URL=https://materials-api.shuleplus.rw/api