NODE_ENV=development
# Parent portal frontend defaults to NEXT_PUBLIC_API_URL=http://localhost:3048/api
PORT=3048
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/parentmis_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
# Comma-separated browser origins. Code also allows *.shuleplus.rw, Capacitor APK origins,
# and origins from FRONTEND_URL / PUBLIC_SITE_URL when set.
CORS_ORIGIN=https://parents.shuleplus.rw,https://parents-api.shuleplus.rw,capacitor://localhost,ionic://localhost,https://localhost,http://localhost,http://localhost:3049,http://localhost:5173,http://localhost:5174
FRONTEND_URL=https://parents.shuleplus.rw
MODULE_SLUG=parent-mis

# Firebase Admin SDK (server-side only)
# Provide either a JSON object string or set GOOGLE_APPLICATION_CREDENTIALS to a service account file.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# IAM — org academic year/term from Authentication org admin
IAM_API_URL=https://shuleplus.rw/api/v1

# Cross-module production APIs (server-to-server)
STUDENT_MANAGEMENT_API_URL=https://studentmanagement-api.shuleplus.rw/api
STUDENT_MANAGEMENT_PUBLIC_URL=https://studentmanagement-api.shuleplus.rw
# Academic marks/reports (production). For local dev use e.g. http://localhost:3003/api and match Academic SERVICE_API_KEY.
ACADEMIC_API_URL=https://academic-api.shuleplus.rw/api
SCHOOL_FEES_API_URL=https://feesapi.shuleplus.rw/api
FEES_API_URL=https://feesapi.shuleplus.rw/api
ATTENDANCE_API_URL=https://attendanceapi.shuleplus.rw/api
TIMETABLE_API_URL=https://timetableapi.shuleplus.rw/api
DISCIPLINE_API_URL=https://disciplineapi.shuleplus.rw/api
CANTEEN_API_URL=https://canteenapi.shuleplus.rw/api
SHULEKIT_API_URL=https://materialsapi.shuleplus.rw/api
# Transport module API (local :4034, production loopback or https://transportapi.shuleplus.rw/api)
TRANSPORT_API_URL=http://127.0.0.1:4034/api
INTERNAL_CHAT_API_URL=http://127.0.0.1:4029/api
PUBLIC_SITE_URL=https://shuleplus.rw

# XentriPay collections gateway (mobile money billing prompts)
XENTRIPAY_BASE_URL=https://test.xentripay.com/api
XENTRIPAY_KEY=your-xentripay-api-key
