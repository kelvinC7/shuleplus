{
  "name": "academic-module-service",
  "version": "1.0.0",
  "description": "ShulePlus Academic Module microservice (student master data)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node scripts/ensure-prisma.js && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "setup:env": "node -e \"require('fs').copyFileSync('.env.example','.env')\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "dev:login": "tsx scripts/dev-login.ts",
    "test:report-card": "tsx src/utils/report-card-component-calc.test.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.32",
    "prisma": "^6.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
