  @@index([organizationId, academicYear, term])
  @@index([organizationId, examinationCode])
  @@index([examinationTypeId])
  @@map("class_examination_timetables")
}

model ClassExaminationSlot {
  id          String                   @id @default(uuid())
  timetableId String                   @map("timetable_id")
  examDate    DateTime                 @map("exam_date")
  session     ExaminationSessionPeriod
  sessionCode String                   @default("MORNING") @map("session_code")
  sessionName String                   @default("Morning") @map("session_name")
  courseName  String                   @map("course_name")
  startTime   String                   @map("start_time")
  endTime     String                   @map("end_time")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  timetable ClassExaminationTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@unique([timetableId, examDate, sessionCode])
  @@index([timetableId, examDate])
  @@map("class_examination_slots")
}

enum ExaminationDistributionMethod {
  KEEP_CLASS
  MIX_CLASSES
}

enum ExaminationListStatus {
  DRAFT
  GENERATED
  PUBLISHED
}

model ExaminationList {
  id                     String                        @id @default(uuid())
  organizationId         String                        @map("organization_id")
  listCode               String?                       @unique @map("list_code")
  examinationTimetableId String?                       @map("examination_timetable_id")
  examinationTypeId      String?                       @map("examination_type_id")
  examinationCode        String?                       @map("examination_code")
  examinationName        String?                       @map("examination_name")
  academicYear           String                        @map("academic_year")
  term                   String
  name                   String?
  startDate              DateTime?                     @map("start_date")
  endDate                DateTime?                     @map("end_date")
  distributionMethod     ExaminationDistributionMethod @map("distribution_method")
  mixQuantity            Int?                          @map("mix_quantity")
  defaultCapacity        Int                           @default(40) @map("default_capacity")
  status                 ExaminationListStatus         @default(DRAFT)
  generatedAt            DateTime?                     @map("generated_at")
  publishedAt            DateTime?                     @map("published_at")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")

  tenant                Tenant                        @relation(fields: [organizationId], references: [organizationId])
  examinationTimetable  ClassExaminationTimetable?    @relation(fields: [examinationTimetableId], references: [id], onDelete: SetNull)
  examinationType       ExaminationType?              @relation(fields: [examinationTypeId], references: [id], onDelete: SetNull)
  rooms                 ExaminationListRoom[]
  classes               ExaminationListClass[]
  allocations           ExaminationAllocation[]
  invigilatorAssignments ExaminationInvigilatorAssignment[]
  attendanceRecords      ExaminationAttendance[]

  @@index([organizationId, academicYear, term])
  @@index([examinationTimetableId])
  @@index([examinationTypeId])
  @@index([examinationCode])
  @@map("examination_lists")
}

model ExaminationListRoom {
  id               String   @id @default(uuid())
  listId           String   @map("list_id")
  sourceRoomId     String?  @map("source_room_id")
  roomName         String   @map("room_name")
  roomNumber       String?  @map("room_number")
  capacity         Int
  isUniqueCapacity Boolean  @default(false) @map("is_unique_capacity")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  list        ExaminationList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  allocations ExaminationAllocation[]
  invigilatorAssignments ExaminationInvigilatorAssignment[]
  attendanceRecords      ExaminationAttendance[]

  @@index([listId])
  @@map("examination_list_rooms")
}

model ExaminationListClass {
  id           String   @id @default(uuid())
  listId       String   @map("list_id")
  classId      String   @map("class_id")
  className    String   @map("class_name")
  studentCount Int      @map("student_count")
  createdAt    DateTime @default(now()) @map("created_at")

  list ExaminationList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, classId])
  @@index([listId])
  @@map("examination_list_classes")
}

model ExaminationAllocation {
  id          String   @id @default(uuid())
  listId      String   @map("list_id")
  roomId      String   @map("room_id")
  studentId   String   @map("student_id")
  studentCode String?  @map("student_code")
  studentName String   @map("student_name")
  classId     String   @map("class_id")
  className   String   @map("class_name")
  gender      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  list ExaminationList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  room ExaminationListRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([listId, studentId])
  @@index([listId])
  @@index([roomId])
  @@map("examination_allocations")
}

enum ExaminationInvigilatorAssignmentType {
  AUTOMATIC
  MANUAL
}

enum ExaminationInvigilatorAssignmentStatus {
  ASSIGNED
  PENDING
  CHECKED_IN
  REPLACED
}

model ExaminationInvigilatorAssignment {
  id                     String                                 @id @default(uuid())
  organizationId         String                                 @map("organization_id")
  examinationTimetableId String?                                @map("examination_timetable_id")
  examinationListId      String                                 @map("examination_list_id")
  examinationCode        String?                                @map("examination_code")
  listCode               String?                                @map("list_code")
  roomId                 String                                 @map("room_id")
  roomName               String                                 @map("room_name")
  roomNumber             String?                                @map("room_number")
  examDate               DateTime                               @map("exam_date")
  session                ExaminationSessionPeriod
  sessionCode            String                                 @default("MORNING") @map("session_code")
  sessionName            String                                 @default("Morning") @map("session_name")
  startTime              String?                                @map("start_time")
  endTime                String?                                @map("end_time")
  teacherUserId          String                                 @map("teacher_user_id")
  teacherName            String                                 @map("teacher_name")
  teacherEmail           String?                                @map("teacher_email")
  assignmentType         ExaminationInvigilatorAssignmentType   @default(AUTOMATIC) @map("assignment_type")
  status                 ExaminationInvigilatorAssignmentStatus @default(ASSIGNED)
  notes                  String?
  createdAt              DateTime                               @default(now()) @map("created_at")
  updatedAt              DateTime                               @updatedAt @map("updated_at")

  tenant               Tenant                     @relation(fields: [organizationId], references: [organizationId])
  examinationTimetable ClassExaminationTimetable? @relation(fields: [examinationTimetableId], references: [id], onDelete: SetNull)
  examinationList      ExaminationList            @relation(fields: [examinationListId], references: [id], onDelete: Cascade)
  room                 ExaminationListRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([examinationListId, roomId, examDate, sessionCode, teacherUserId], map: "exam_invig_session_identity_unique")
  @@index([organizationId, examinationListId, examDate, sessionCode], map: "exam_invig_list_session_code_idx")
  @@index([teacherUserId, examDate, sessionCode], map: "exam_invig_teacher_session_code_idx")
  @@index([examinationCode])
  @@map("examination_invigilator_assignments")
}

enum ExaminationAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model ExaminationAttendance {
  id                String                      @id @default(uuid())
  organizationId    String                      @map("organization_id")
  examinationListId String                      @map("examination_list_id")
  roomId            String                      @map("room_id")
  studentId         String                      @map("student_id")
  studentCode       String?                     @map("student_code")
  studentName       String                      @map("student_name")
  classId           String?                     @map("class_id")
  className         String?                     @map("class_name")
  examDate          DateTime                    @map("exam_date")
  session           ExaminationSessionPeriod
  sessionCode       String                      @default("MORNING") @map("session_code")
  sessionName       String                      @default("Morning") @map("session_name")
  status            ExaminationAttendanceStatus @default(PRESENT)
  markedByUserId    String?                     @map("marked_by_user_id")
  markedByName      String?                     @map("marked_by_name")
  markedAt          DateTime?                   @map("marked_at")
  notes             String?
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  examinationList ExaminationList     @relation(fields: [examinationListId], references: [id], onDelete: Cascade)
  room            ExaminationListRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([examinationListId, roomId, examDate, sessionCode, studentId], map: "exam_attendance_session_identity_unique")
  @@index([organizationId, examinationListId, examDate, sessionCode], map: "exam_attendance_list_session_code_idx")
  @@index([roomId, examDate, sessionCode], map: "exam_attendance_room_session_code_idx")
  @@map("examination_attendance")
}

// Nursery academic reports

model NurseryClassConfig {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  classId        String   @map("class_id")
  className      String?  @map("class_name")
  academicYear   String   @map("academic_year")
  templateKey    String   @default("nursery-standard") @map("template_key")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, classId, academicYear])
  @@index([organizationId, academicYear])
  @@map("nursery_class_configs")
}

model NurserySubjectConfig {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  classId            String   @map("class_id")
  subjectId          String   @map("subject_id")
  subjectName        String?  @map("subject_name")
  learningArea       String   @map("learning_area")
  maxMark            Float    @default(100) @map("max_mark")
  isVisible          Boolean  @default(true) @map("is_visible")
  contributesToTotal Boolean  @default(true) @map("contributes_to_total")
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, classId, subjectId])
  @@index([organizationId, classId])
  @@map("nursery_subject_configs")
}

model NurseryReport {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  studentId          String    @map("student_id")
  classId            String    @map("class_id")
  academicYear       String    @map("academic_year")
  term               String
  reportKind         String    @default("standard") @map("report_kind")
  status             String    @default("GENERATED")
  studentName        String?   @map("student_name")
  className          String?   @map("class_name")
  totalScore         Float?    @map("total_score")
  average            Float?
  classAverage       Float?    @map("class_average")
  teacherComment     String?   @map("teacher_comment") @db.Text
  headTeacherComment String?   @map("head_teacher_comment") @db.Text
  verificationCode   String    @unique @map("verification_code")
  snapshot           Json
  generatedAt        DateTime  @default(now()) @map("generated_at")
  generatedBy        String?   @map("generated_by")
  publishedAt        DateTime? @map("published_at")
  publishedBy        String?   @map("published_by")
  publishedByName    String?   @map("published_by_name")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, studentId, classId, academicYear, term, reportKind], map: "nursery_reports_student_term_kind_key")
  @@index([organizationId, classId, academicYear, term, reportKind])
  @@index([organizationId, academicYear, term, reportKind])
  @@map("nursery_reports")
}
