// ─── Exam Planning (smart timetable, seating, invigilators, live attendance) ───

enum ExamSessionLifecycle {
  DRAFT
  REVIEWED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ExamSlotStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ExamAttendanceState {
  NOT_ARRIVED
  PRESENT
  LATE
  ABSENT
  IN_PROGRESS
  SUBMITTED
  EXITED
}

enum ExamConflictType {
  STUDENT
  ROOM
  INVIGILATOR
  CAPACITY
  DURATION
  MAJOR_SPACING
  DAILY_LOAD
  SEATING
}

enum ExamConflictSeverity {
  ERROR
  WARNING
}

enum ExamDutyMode {
  AUTO
  MANUAL
  LOCKED
}

enum ExamCheckMethod {
  MANUAL
  QR
  RFID
}

enum PublicationAccessPolicy {
  PAID_ONLY
  ALL_PARENTS
}

enum AssessmentReportingStage {
  UNASSIGNED
  BEGINNING_TERM
  MID_TERM
  TERM_FINAL
}

enum PublicationBatchStatus {
  DRAFT
  PUBLISHED
  PARTIALLY_PUBLISHED
  REVOKED
}

enum MarksSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  APPROVED
  PUBLISHED
}

enum MarksApprovalStatus {
  PENDING
  APPROVED
  RETURNED
  REJECTED
}

model ExamSession {
  id                     String               @id @default(uuid())
  organizationId         String               @map("organization_id")
  name                   String
  academicYear           String               @map("academic_year")
  term                   String
  examType               String               @map("exam_type")
  startDate              DateTime             @map("start_date")
  endDate                DateTime             @map("end_date")
  generateAutomatically  Boolean              @default(true) @map("generate_automatically")
  status                 ExamSessionLifecycle @default(DRAFT)
  maxExamsPerDay         Int                  @default(2) @map("max_exams_per_day")
  majorGapSessions       Int                  @default(1) @map("major_gap_sessions")
  rooms                  Json
  timeSlots              Json                 @map("time_slots")
  days                   Json
  invigilatorSettings    Json                 @map("invigilator_settings")
  readinessScore         Int                  @default(0) @map("readiness_score")
  createdBy              String?              @map("created_by")
  publishedAt            DateTime?            @map("published_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [organizationId], references: [organizationId])
  classes       ExamSessionClass[]
  courses       ExamSessionCourse[]
  schedules     ExamSchedule[]
  seats         ExamSeat[]
  attendances   ExamAttendance[]
  conflicts     ExamConflict[]
  duties        ExamInvigilatorDuty[]
  auditLogs     ExamAuditLog[]

  @@index([organizationId])
  @@index([organizationId, academicYear, term])
  @@index([organizationId, status])
  @@map("exam_sessions")
}

model ExamSessionClass {
  id           String  @id @default(uuid())
  sessionId    String  @map("session_id")
  classId      String  @map("class_id")
  className    String  @map("class_name")
  studentCount Int     @default(0) @map("student_count")
  selected     Boolean @default(true)

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, classId])
  @@index([sessionId])
  @@map("exam_session_classes")
}

model ExamSessionCourse {
  id              String  @id @default(uuid())
  sessionId       String  @map("session_id")
  classId         String  @map("class_id")
  subjectName     String  @map("subject_name")
  durationMinutes Int     @default(120) @map("duration_minutes")
