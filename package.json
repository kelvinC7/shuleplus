{
  "name": "shuleplus",
  "private": true,
  "scripts": {
    "db:setup": "node scripts/setup-module-databases.mjs",
    "db:setup:academic": "node scripts/setup-module-databases.mjs --only=Academic",
    "subdomains:apply": "node scripts/apply-module-subdomains.mjs",
    "subdomains:preview": "node scripts/apply-module-subdomains.mjs --dry-run",
    "subdomains:doc": "node scripts/generate-subdomains-doc.mjs",
    "ports:check": "node scripts/check-module-ports.mjs",
    "fix:esbuild": "node scripts/ensure-esbuild.mjs",
    "repair:deps": "node scripts/repair-pnpm.mjs"
  },
  "workspaces": [
    "packages/*",
    "Authentication/Frontend",
    "HR/Frontend",
    "Payroll/Frontend",
    "TeacherPortal/Frontend",
    "SampleModule/Frontend",
    "StudentDiscpline/Frontend"
  ],
  "devDependencies": {
    "docx": "^9.7.1",
    "esbuild": "0.28.1",
    "tsx": "4.20.3"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.28.1"
  }
}
