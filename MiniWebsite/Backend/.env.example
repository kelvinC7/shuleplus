NODE_ENV=development
PORT=3055
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mini_website_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
# Must match IAM PLATFORM_SERVICE_KEY / MODULE_PROVISIONING_KEY
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
# BabyeyiWizard API for school circulars
BABYEYI_API_URL=http://localhost:3012/api
CORS_ORIGIN=http://localhost:3054,http://localhost:3000
MODULE_SLUG=mini-website

# ── Production (website.shuleplus.rw) ───────────────────────────────────────
# NODE_ENV=production
# PORT=4026
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/mini_website_db
# PUBLIC_BASE_URL=https://website-api.shuleplus.rw
# IAM_API_URL=http://localhost:4001/api/v1
# IAM_PUBLIC_ORIGIN=https://shuleplus.rw
# BABYEYI_API_URL=http://localhost:4017/api
# CORS_ORIGIN=https://website.shuleplus.rw,https://shuleplus.rw,https://app.shuleplus.rw,https://www.shuleplus.rw
# JWT_ACCESS_SECRET=<same as Authentication/Backend/.env>
# PLATFORM_SERVICE_KEY=<same as Authentication/Backend/.env>
