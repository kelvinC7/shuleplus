NODE_ENV=development
PORT=3014
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_fees_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3015
IAM_API_URL=http://localhost:3001/api/v1
BABYEYI_API_URL=http://localhost:3012/api
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
NOTIFICATION_SERVICE_URL=http://localhost:3002/api/notifications
NOTIFICATION_SERVICE_API_KEY=change-me-notification-service-key
PARENT_MIS_API_URL=http://localhost:3048/api
PAYMENT_PORTAL_URL=http://localhost:3000/pay-fees
FEES_PORTAL_URL=http://localhost:3015

# Payment provider integration (production values are shown here for reference)
PAYMENT_AUTH_URL=https://shuleplus.rw/api/v1/developers/oauth/token
PAYMENT_VALIDATION_URL=https://fees.shuleplus.rw/api/integrations/payments/validate
PAYMENT_NOTIFICATION_URL=https://fees.shuleplus.rw/api/integrations/payments/notify
PAYMENT_REVERSAL_URL=https://fees.shuleplus.rw/api/integrations/payments/reverse
PAYMENT_CALLBACK_URL=https://fees.shuleplus.rw/api/integrations/payments/callback
# Shared secret with the payment provider. Send as x-api-key (or Bearer) on callback calls.
# Never commit the real value; set it only in the server .env.
PAYMENT_INTEGRATION_API_KEY=change-me-shared-provider-secret
