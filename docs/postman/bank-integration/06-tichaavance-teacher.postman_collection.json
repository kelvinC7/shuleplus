{
  "info": {
    "name": "ShulePlus — 6. TichaAvance Teacher (TichaPortal)",
    "description": "# TichaAvance — Teacher Flow (TichaPortal BFF)\n\nSame paths used by **ticha.shuleplus.rw** — proxied to KaziAvance.\n\n## Scopes\n- `ticha.read` — dashboard, catalog, history\n- `ticha.write` — submit advance requests\n\n## Flow\n1. Dashboard → 2. Catalog → 3. Calculator → 4. Submit request → 5. Track workflow\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "advance_request_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Teacher Dashboard",
      "description": "",
      "item": [
        {
          "name": "BFF Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{ticha_api_url}}/api/health",
              "host": [
                "{{ticha_api_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          }
        },
        {
