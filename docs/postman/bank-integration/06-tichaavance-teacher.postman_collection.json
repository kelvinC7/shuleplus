    {
      "name": "Submit Advance Request",
      "description": "",
      "item": [
        {
          "name": "Cashout Catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{ticha_api_url}}/kazi/api/advance/catalog",
              "host": [
                "{{ticha_api_url}}"
              ],
              "path": [
                "kazi",
                "api",
                "advance",
                "catalog"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Repayment Calculator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{ticha_api_url}}/kazi/api/advance/calculator",
              "host": [
                "{{ticha_api_url}}"
              ],
              "path": [
                "kazi",
                "api",
                "advance",
                "calculator"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"desiredAmount\": 500000,\n  \"repaymentMonths\": 6\n}"
            }
          }
        },
        {
          "name": "Submit Advance Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{ticha_api_url}}/kazi/api/advance/requests",
              "host": [
                "{{ticha_api_url}}"
              ],
              "path": [
                "kazi",
                "api",
                "advance",
                "requests"
              ]
            },
            "description": "Multipart with signature in production. JSON body for API testing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500000,\n  \"months\": 6,\n  \"purpose\": \"Emergency\",\n  \"description\": \"Partner API test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.id || json?.data?.id;",
                  "if (id) pm.environment.set(\"advance_request_id\", id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Pending Request",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{ticha_api_url}}/kazi/api/advance/requests/{{advance_request_id}}",
              "host": [
                "{{ticha_api_url}}"
              ],
              "path": [
                "kazi",
                "api",
                "advance",
                "requests",
                "{{advance_request_id}}"
              ]
            },
            "description": ""
          }
        }
      ]
    }
  ]
}