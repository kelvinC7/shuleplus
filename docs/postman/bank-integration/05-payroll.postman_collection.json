{
  "info": {
    "name": "ShulePlus — 5. Payroll API",
    "description": "# Payroll Module\n\nStaff payroll, runs, bank disbursement export, and KaziAvance deduction sync.\n\n## Scopes\n- `payroll.read` — dashboard, staff, runs, disbursement\n- `payroll.process` — trigger runs, mark paid, apply deductions\n\n## Gateway\n`{{iam_base_url}}/developers/gateway/payroll/...`\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "staff_id",
      "value": ""
    },
    {
      "key": "payroll_run_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
