{
  "info": {
    "name": "ShulePlus — 4. School Fees Portal API",
    "description": "# School Fees Portal — Collections, Structures & Payments\n\nCore financial module for schools. Used by school bursars and bank integrations.\n\n## Scopes\n| Scope | Purpose |\n|-------|---------|\n| `fees.read` | Structures, bills, dashboard, collection lookup |\n| `fees.write` | Create/update fee structures |\n| `payment.create` | Record payments, initiate public pay |\n| `payment.read` | Status, receipts |\n\nDirect API base: `{{fees_api_url}}` (e.g. `https://fees.shuleplus.rw/api`)\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Public — Parent Payments",
      "description": "Unauthenticated parent payment APIs.",
      "item": [
        {
          "name": "Get Student Fees",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{fees_api_url}}/public/student-fees?organizationId={{organization_id}}&studentCode={{student_code}}&academicYear={{academic_year}}&term={{term}}",
              "host": [
                "{{fees_api_url}}"
              ],
              "path": [
                "public",
                "student-fees"
              ],
              "query": [
                {
                  "key": "organizationId",
                  "value": "{{organization_id}}"
                },
                {
                  "key": "studentCode",
                  "value": "{{student_code}}"
                },
                {
                  "key": "academicYear",
                  "value": "{{academic_year}}"
                },
                {
                  "key": "term",
                  "value": "{{term}}"
                }
              ]
            },
            "description": "",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Initiate Public Payment",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{fees_api_url}}/public/payments/initiate",
              "host": [
                "{{fees_api_url}}"
              ],
              "path": [
                "public",
                "payments",
                "initiate"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentCode\": \"{{student_code}}\",\n  \"amount\": 5000,\n  \"method\": \"MOMO\",\n  \"phone\": \"0788123456\",\n  \"academicYear\": \"{{academic_year}}\",\n  \"term\": \"{{term}}\"\n}"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const ref = json?.data?.reference ?? json?.reference;",
                  "if (ref) { pm.environment.set(\"payment_reference\", ref); console.log(\"payment_reference=\" + ref); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{fees_api_url}}/public/payments/{{payment_reference}}/status",
              "host": [
                "{{fees_api_url}}"
              ],
              "path": [
                "public",
                "payments",
                "{{payment_reference}}",
                "status"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Verify Receipt",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{fees_api_url}}/public/receipts/{{receipt_number}}",
              "host": [
                "{{fees_api_url}}"
              ],
              "path": [
                "public",
                "receipts",
                "{{receipt_number}}"
              ]
            },
            "description": ""
          }
        }
      ]
    },
