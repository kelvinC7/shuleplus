          "name": "Create Fee Structure",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{fees_api_url}}/structures",
              "host": [
                "{{fees_api_url}}"
              ],
              "path": [
                "structures"
              ]
            },
            "description": "Requires fees.write scope. Creates active structure with line items.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Term 1 Fees 2025-2026\",\n  \"code\": \"FS-2025-T1\",\n  \"academicYear\": \"{{academic_year}}\",\n  \"term\": \"{{term}}\",\n  \"className\": \"P5 A\",\n  \"status\": \"ACTIVE\",\n  \"items\": [\n    {\n      \"name\": \"Tuition\",\n      \"amount\": 150000,\n      \"itemType\": \"MANDATORY\",\n      \"paymentType\": \"SCHOOL_ACCOUNT\"\n    },\n    {\n      \"name\": \"Activity Fee\",\n      \"amount\": 10000,\n      \"itemType\": \"MANDATORY\",\n      \"paymentType\": \"SCHOOL_ACCOUNT\"\n    }\n  ]\n}"
            }
          }
        },
