              ],
              "path": [
                "api",
                "org-admin",
                "requests",
                "{{advance_request_id}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"review\",\n  \"comment\": \"Reviewing documentation\"\n}"
            }
          }
        },
        {
          "name": "2. Approve Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
