{
  "info": {
    "name": "ShulePlus — 7. KaziAvance Approval (Org Admin)",
    "description": "# KaziAvance — Org Admin Approval Flow\n\nDirect KaziAvance API for school finance / HR admins.\n\n## Scopes\n- `kazi.read` — list requests, employees, policies\n- `kazi.write` — manage employees, policies\n- `kazi.approve` — review, approve, reject, disburse\n\n## Approval actions (PATCH /requests/:id)\n`{ \"action\": \"review\" | \"approve\" | \"reject\" | \"disburse\", \"amount\": 500000, \"comment\": \"...\" }`\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
