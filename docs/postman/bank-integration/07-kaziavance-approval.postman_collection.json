              }
            ],
            "url": {
              "raw": "{{kazi_api_url}}/api/org-admin/requests/{{advance_request_id}}",
              "host": [
                "{{kazi_api_url}}"
              ],
              "path": [
                "api",
                "org-admin",
                "requests",
                "{{advance_request_id}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"disburse\",\n  \"comment\": \"Disbursed to employee account\"\n}"
            }
          }
        },
        {
          "name": "Reject Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
