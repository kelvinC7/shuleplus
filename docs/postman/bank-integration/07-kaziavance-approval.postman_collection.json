            "url": {
              "raw": "{{kazi_api_url}}/api/org-admin/requests/{{advance_request_id}}",
              "host": [
                "{{kazi_api_url}}"
              ],
              "path": [
                "api",
                "org-admin",
                "requests",
                "{{advance_request_id}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\",\n  \"amount\": 500000,\n  \"comment\": \"Approved by finance\"\n}"
            }
          }
        },
        {
          "name": "3. Disburse Funds",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
