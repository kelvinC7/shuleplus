              ],
              "path": [
                "api",
                "org-admin",
                "requests",
                "{{advance_request_id}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reject\",\n  \"comment\": \"Insufficient eligibility\"\n}"
            }
          }
        }
