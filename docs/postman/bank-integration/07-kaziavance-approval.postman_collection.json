    {
      "name": "Staff Setup for TichaAvance",
      "description": "Search staff → set salary → enable advance (same as TichaPortal org admin).",
      "item": [
        {
          "name": "1. Sync Staff Directory (HR/Timetable/IAM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kazi_api_url}}/api/org-admin/employees/sync-directory",
              "host": [
                "{{kazi_api_url}}"
              ],
              "path": [
                "api",
                "org-admin",
                "employees",
                "sync-directory"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "2. Lookup Staff by Name / Code / ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kazi_api_url}}/api/org-admin/employees/lookup?q={{staff_search}}",
              "host": [
                "{{kazi_api_url}}"
              ],
              "path": [
                "api",
                "org-admin",
                "employees",
                "lookup"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{staff_search}}"
                }
              ]
            },
            "description": "Also supports ?id=, ?employeeCode=, ?email=, ?iamUserId=, ?phone="
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const row = json?.data?.[0];",
                  "if (row?.id) pm.environment.set(\"employee_id\", row.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Set Salary + Enable Advance (one step)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kazi_api_url}}/api/org-admin/employees/{{employee_id}}/advance-setup",
              "host": [
                "{{kazi_api_url}}"
              ],
              "path": [
                "api",
                "org-admin",
                "employees",
                "{{employee_id}}",
                "advance-setup"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grossSalary\": 850000,\n  \"netSalary\": 720000,\n  \"allowances\": 50000,\n  \"deductions\": 180000,\n  \"allowAdvance\": true,\n  \"eligibilityStatus\": \"Eligible\",\n  \"maxSalaryPercent\": 50,\n  \"reason\": \"Salary set via partner API for TichaAvance\"\n}"
            }
          }
        },
        {
          "name": "4. Or — Set Salary Only",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kazi_api_url}}/api/org-admin/employees/{{employee_id}}/salary",
              "host": [
                "{{kazi_api_url}}"
              ],
              "path": [
                "api",
                "org-admin",
                "employees",
                "{{employee_id}}",
                "salary"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grossSalary\": 850000,\n  \"netSalary\": 720000,\n  \"allowances\": 50000,\n  \"deductions\": 180000,\n  \"reason\": \"Manual salary update\"\n}"
            }
          }
        },
        {
          "name": "5. Or — Enable Eligibility Only",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kazi_api_url}}/api/org-admin/employees/{{employee_id}}/eligibility",
              "host": [
                "{{kazi_api_url}}"
              ],
              "path": [
                "api",
                "org-admin",
                "employees",
                "{{employee_id}}",
                "eligibility"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allowAdvance\": true,\n  \"eligibilityStatus\": \"Eligible\",\n  \"maxSalaryPercent\": 50,\n  \"maxActiveAdvances\": 1,\n  \"waitingPeriodDays\": 0\n}"
            }
          }
        },
        {
          "name": "6. Pull Salary from Payroll Module",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-developer-environment",
                "value": "{{developer_environment}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{kazi_api_url}}/api/org-admin/employees/{{employee_id}}/fetch-payroll-salary",
              "host": [
                "{{kazi_api_url}}"
              ],
              "path": [
                "api",
                "org-admin",
                "employees",
                "{{employee_id}}",
                "fetch-payroll-salary"
              ]
            },
            "description": ""
          }
        }
      ]
