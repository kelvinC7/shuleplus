NODE_ENV=development
PORT=3002
API_PREFIX=/api/notifications

# Database (separate from IAM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shuleplus_notifications?schema=public"

# Redis (OTP storage)
REDIS_URL="redis://localhost:6379"

# Inter-service authentication — other microservices must send this header
SERVICE_API_KEY=change-me-notification-service-key

# CORS (IAM, Finance, Education, HR, RFID frontends/backends)
CORS_ORIGIN=http://localhost:3000

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShulePlus <noreply@shuleplus.com>

# SMS (AfroBulkSMS)
SMS_API_URL=https://afrobulksms.com/api/sent/compose
SMS_API_KEY=
SMS_FROM_NUMBER=
SMS_SENDER_ID=edupoto
SMS_FROM_NUMBER=250791902917SHULEPLUS

# Push (placeholder — wire Firebase/APNs in production)
PUSH_PROVIDER=console

# Swagger API docs
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
