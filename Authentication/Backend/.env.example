# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
# Production IAM public API (optional fallback if not set in Super Admin → Developer Access)
# Super Admin UI overrides this — preferred way to set gateway URL on server.
# PUBLIC_API_URL=https://shuleplus.rw/api/v1

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/shuleplus_iam?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_INACTIVITY_MINUTES=30

# CORS
CORS_ORIGIN=http://localhost:3000

# Module microservice provisioning (must match each module SERVICE_API_KEY)
# Users & Access create/assign fans out staff to Kazi, HR, and Timetable with this key.
PLATFORM_SERVICE_KEY=dev-service-key
MODULE_PROVISIONING_KEY=dev-service-key

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs

# ROOT_ADMIN (seed only — never hardcode in source)
ROOT_ADMIN_EMAIL=hirwabasekecedrick@gmail.com
ROOT_ADMIN_PASSWORD=Jh!111cg
ROOT_ADMIN_FIRST_NAME=ISHIMWE
ROOT_ADMIN_LAST_NAME=Theoneste
ROOT_ADMIN_PHONE=0796898894

# Email (SMTP) — for MFA OTP emails (leave empty to log OTP in backend console)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ShulePlus <noreply@shuleplus.com>

# Notification microservice (optional — leave empty to send email directly from IAM SMTP above)
# NOTIFICATION_SERVICE_URL=http://localhost:3002/api/notifications
# NOTIFICATION_SERVICE_API_KEY=

# AfroBulkSMS — same as Attendance (OTP, Super Admin SMS, Smart Access)
SMS_API_URL=https://afrobulksms.com/api/sent/compose
SMS_API_KEY=
SMS_SENDER_ID=edupoto
SMS_FROM_NUMBER=250791902917

# Module service URLs (Super Admin gate devices, Smart Access, Developer Gateway, etc.)
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
ATTENDANCE_API_URL=http://localhost:3024/api
SCHOOL_FEES_API_URL=http://localhost:3014/api
BABYEYI_WIZARD_API_URL=http://localhost:3012/api
WEBPAGE_BABYEYI_API_URL=http://localhost:3099/api
PAYROLL_API_URL=http://localhost:3026/api
KAZI_API_URL=http://localhost:4400
TICHA_PORTAL_API_URL=http://localhost:4000/api

# Developer Portal — sandbox org for service-auth gateway calls to protected module routes
# Use a real organization UUID from your IAM database that has student-management + school-fees assigned
# Developer Portal — live ST THEO SCHOOL (Organization Admin + Student Management UI)
DEVELOPER_SANDBOX_ORGANIZATION_ID=b4e8c3c3-b510-44e1-9f92-696e2a1506f3

# Edge maintenance (nginx flag) — toggled from Root Admin Control Center on production server
# NGINX_MAINTENANCE_FLAG_PATH=/var/www/shuleplus/maintenance/ON
# NGINX_MAINTENANCE_SCRIPT=/root/apps/shuleplus/ShulePlus/scripts/toggle-nginx-maintenance.sh
