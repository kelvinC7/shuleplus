# ShulePlus — shared platform secrets (copy values into each service .env)
#
# IAM Backend (Authentication/Backend/.env):
#   PLATFORM_SERVICE_KEY=...
#   MODULE_PROVISIONING_KEY=...   (same value; IAM sends this as x-service-key)
#
# Each module microservice (e.g. SampleModule/Backend/.env):
#   PLATFORM_SERVICE_KEY=...
#   SERVICE_API_KEY=...           (same value; module validates x-service-key)
#
# JWT (must match IAM + all module frontends/backends):
#   JWT_ACCESS_SECRET=...

PLATFORM_SERVICE_KEY=dev-service-key
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
