NODE_ENV=development
PORT=3051
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_uniform_module_db
# Must match Authentication/Backend/.env JWT_ACCESS_SECRET exactly
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
PLATFORM_SERVICE_KEY=dev-service-key
# Must match Authentication MODULE_PROVISIONING_KEY (local default: dev-service-key)
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3050
MODULE_SLUG=school-uniform
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
# Deprecated — roster sync uses Student Management, not Academic
# ACADEMIC_API_URL=http://localhost:3003/api
