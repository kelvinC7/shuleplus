NODE_ENV=development
PORT=3024
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_rfid_db
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32chars
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3025
MODULE_SLUG=attendance
# Required for gate readers to resolve Smart Access RFID cards (Super Admin Digital ID)
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
PARENT_MIS_API_URL=http://localhost:3048/api
# Local dev ports (production: IAM 4001, HR 4007, Timetable 4014 — set by redeploy-module.sh)
IAM_API_URL=http://localhost:3001/api/v1
HR_API_URL=http://localhost:3005/api
TIMETABLE_API_URL=http://localhost:3010/api
NOTIFICATION_SERVICE_URL=http://localhost:3002/api/notifications
NOTIFICATION_SERVICE_API_KEY=dev-service-key
# AfroBulkSMS (parent SMS) — used when Notification Service is down or unset
# Never commit real keys; set on server only
SMS_API_URL=https://afrobulksms.com/api/sent/compose
SMS_API_KEY=
SMS_SENDER_ID=edupoto
SMS_FROM_NUMBER=250791902917
