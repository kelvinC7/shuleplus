NODE_ENV=development
PORT=3012
API_PREFIX=/api
# Append ?connection_limit=2 on production when many ShulePlus modules share one Postgres host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/babyeyi_wizard_db?connection_limit=2
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3013
MODULE_SLUG=babyeyi
UPLOAD_DIR=uploads
IAM_API_URL=http://localhost:3001/api/v1
NESA_API_URL=http://localhost:3014/api
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
VERIFY_PUBLIC_URL=http://localhost:3013/verify
