generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum StoreType {
  MAIN
  WAREHOUSE
  BRANCH
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  ISSUED
}

enum IssueStatus {
  DRAFT
  APPROVED
  REJECTED
  ISSUED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
}

enum AdjustmentReason {
  DAMAGE
  SPOILAGE
  EXPIRED
  COUNTING_ERROR
  DONATION
  LOSS
}

model Tenant {
  id               String       @id @default(uuid())
  organizationId   String       @unique @map("organization_id")
  organizationCode String?      @map("organization_code")
  organizationName String       @map("organization_name")
  status           TenantStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  productCategories   ProductCategory[]
  products            Product[]
  stores              Store[]
  storeShelves        StoreShelf[]
  suppliers           Supplier[]
  inventoryBatches    InventoryBatch[]
  stockReceivings     StockReceiving[]
  stockIssues         StockIssue[]
  stockTransfers      StockTransfer[]
  stockAdjustments    StockAdjustment[]
  stockRequests       StockRequest[]
  physicalStockCounts PhysicalStockCount[]
  disposals           Disposal[]
  attachments         Attachment[]
  settings            Setting[]
  activityLogs        ActivityLog[]

  @@map("tenants")
}

model UserCache {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  email          String?
  displayName    String?  @map("display_name")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  @@unique([organizationId, userId])
  @@map("users_cache")
}

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  products Product[]
  tenant   Tenant    @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("product_categories")
}

model Product {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  name            String
  sku             String        @map("sku")
  barcode         String?       @map("barcode")
  categoryId      String        @map("category_id")
  brand           String?
  unitOfMeasure   String        @map("unit_of_measure")
  imageUrl        String?       @map("image_url")
  description     String?
  costPrice       Decimal?      @map("cost_price") @db.Decimal(12, 2)
  sellingPrice    Decimal?      @map("selling_price") @db.Decimal(12, 2)
  reorderLevel    Decimal?      @map("reorder_level") @db.Decimal(12, 2)
  minimumStock    Decimal?      @map("minimum_stock") @db.Decimal(12, 2)
  maximumStock    Decimal?      @map("maximum_stock") @db.Decimal(12, 2)
  supplierId      String?       @map("supplier_id")
  storageLocation String?       @map("storage_location")
  status          ProductStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  category        ProductCategory          @relation(fields: [categoryId], references: [id])
  supplier        Supplier?                @relation(fields: [supplierId], references: [id])
  batches         InventoryBatch[]
  receivingItems  StockReceivingItem[]
  issueItems      StockIssueItem[]
  transferItems   StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  requestItems    StockRequestItem[]
  countItems      PhysicalStockCountItem[]
  disposalItems   DisposalItem[]
  tenant          Tenant                   @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@map("products")
}

model Store {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  code           String    @map("code")
  type           StoreType @default(BRANCH)
  location       String?
  managerName    String?   @map("manager_name")
  managerContact String?   @map("manager_contact")
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  shelves             StoreShelf[]
  batches             InventoryBatch[]
  receivingFrom       StockReceiving[]
  issues              StockIssue[]
  transfersFrom       StockTransfer[]      @relation("transferFrom")
  transfersTo         StockTransfer[]      @relation("transferTo")
  adjustments         StockAdjustment[]
  stockRequests       StockRequest[]
  physicalStockCounts PhysicalStockCount[]
  disposals           Disposal[]
  tenant              Tenant               @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("stores")
}

model StoreShelf {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  storeId        String   @map("store_id")
  name           String
  code           String   @map("code")
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store  Store  @relation(fields: [storeId], references: [id])
  tenant Tenant @relation(fields: [organizationId], references: [organizationId])

  @@unique([storeId, code])
  @@index([organizationId])
  @@index([storeId])
  @@map("store_shelves")
}

model Supplier {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  name              String
  contactPerson     String?  @map("contact_person")
  email             String?
  phone             String?
  address           String?
  tinNumber         String?  @map("tin_number")
  paymentMethod     String?  @map("payment_method")
  mobileMoneyNumber String?  @map("mobile_money_number")
  bankName          String?  @map("bank_name")
  bankAccountNumber String?  @map("bank_account_number")
  contractUrl       String?  @map("contract_url")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  products   Product[]
  receivings StockReceiving[]
  tenant     Tenant           @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("suppliers")
}

model InventoryBatch {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  productId         String    @map("product_id")
  storeId           String?   @map("store_id")
  batchNumber       String?   @map("batch_number")
  quantity          Decimal   @default(0) @db.Decimal(12, 2)
  unitCost          Decimal?  @map("unit_cost") @db.Decimal(12, 2)
  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime? @map("expiry_date")
  receivedDate      DateTime  @default(now()) @map("received_date")
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product         Product               @relation(fields: [productId], references: [id])
  store           Store?                @relation(fields: [storeId], references: [id])
  issueItems      StockIssueItem[]
  transferItems   StockTransferItem[]
  adjustmentItems StockAdjustmentItem[]
  disposalItems   DisposalItem[]
  tenant          Tenant                @relation(fields: [organizationId], references: [organizationId])

  @@index([organizationId])
  @@index([productId])
  @@index([storeId])
  @@index([expiryDate])
  @@map("inventory_batches")
}

model StockReceiving {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  grnNumber          String   @map("grn_number")
  storeId            String   @map("store_id")
  supplierId         String?  @map("supplier_id")
  stockRequestId     String?  @map("stock_request_id")
  invoiceNumber      String?  @map("invoice_number")
  deliveryNoteNumber String?  @map("delivery_note_number")
  receivedBy         String   @map("received_by")
  notes              String?
  receivedDate       DateTime @default(now()) @map("received_date")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  store        Store                @relation(fields: [storeId], references: [id])
  supplier     Supplier?            @relation(fields: [supplierId], references: [id])
  stockRequest StockRequest?        @relation(fields: [stockRequestId], references: [id])
  items        StockReceivingItem[]
  tenant       Tenant               @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, grnNumber])
  @@index([organizationId])
  @@index([storeId])
  @@index([stockRequestId])
  @@map("stock_receivings")
}

model StockReceivingItem {
  id                String    @id @default(uuid())
  receivingId       String    @map("receiving_id")
  productId         String    @map("product_id")
  batchNumber       String?   @map("batch_number")
  quantity          Decimal   @db.Decimal(12, 2)
  unitCost          Decimal?  @map("unit_cost") @db.Decimal(12, 2)
  expiryDate        DateTime? @map("expiry_date")
  manufacturingDate DateTime? @map("manufacturing_date")

  receiving StockReceiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])

  @@index([receivingId])
  @@index([productId])
  @@map("stock_receiving_items")
}

model StockIssue {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  issueNumber    String      @map("issue_number")
  storeId        String      @map("store_id")
  issuedTo       String      @map("issued_to")
  issuedToType   String      @map("issued_to_type")
  issuedToName   String      @map("issued_to_name")
  purpose        String?
  requestedBy    String?     @map("requested_by")
  approvedBy     String?     @map("approved_by")
  issuedBy       String?     @map("issued_by")
  status         IssueStatus @default(DRAFT)
  notes          String?
  issuedAt       DateTime?   @map("issued_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  store  Store            @relation(fields: [storeId], references: [id])
  items  StockIssueItem[]
  tenant Tenant           @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, issueNumber])
  @@index([organizationId])
  @@index([storeId])
  @@map("stock_issues")
}

model StockIssueItem {
  id        String   @id @default(uuid())
  issueId   String   @map("issue_id")
  productId String   @map("product_id")
  batchId   String?  @map("batch_id")
  quantity  Decimal  @db.Decimal(12, 2)
  unitCost  Decimal? @map("unit_cost") @db.Decimal(12, 2)

  issue   StockIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  batch   InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([issueId])
  @@index([productId])
  @@map("stock_issue_items")
}

model StockTransfer {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  transferNumber String         @map("transfer_number")
  fromStoreId    String         @map("from_store_id")
  toStoreId      String         @map("to_store_id")
  requestedBy    String         @map("requested_by")
  approvedBy     String?        @map("approved_by")
  receivedBy     String?        @map("received_by")
  status         TransferStatus @default(PENDING)
  notes          String?
  transferredAt  DateTime?      @map("transferred_at")
  receivedAt     DateTime?      @map("received_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  fromStore Store               @relation(fields: [fromStoreId], references: [id], name: "transferFrom")
  toStore   Store               @relation(fields: [toStoreId], references: [id], name: "transferTo")
  items     StockTransferItem[]
  tenant    Tenant              @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, transferNumber])
  @@index([organizationId])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String   @id @default(uuid())
  transferId String   @map("transfer_id")
  productId  String   @map("product_id")
  batchId    String?  @map("batch_id")
  quantity   Decimal  @db.Decimal(12, 2)
  unitCost   Decimal? @map("unit_cost") @db.Decimal(12, 2)

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  batch    InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model StockAdjustment {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  adjustmentNumber  String           @map("adjustment_number")
  storeId           String           @map("store_id")
  reason            AdjustmentReason
  reasonDescription String?          @map("reason_description")
  adjustedBy        String           @map("adjusted_by")
  approvedBy        String?          @map("approved_by")
  notes             String?
  adjustmentDate    DateTime         @default(now()) @map("adjustment_date")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  store  Store                 @relation(fields: [storeId], references: [id])
  items  StockAdjustmentItem[]
  tenant Tenant                @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, adjustmentNumber])
  @@index([organizationId])
  @@index([storeId])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String   @id @default(uuid())
  adjustmentId String   @map("adjustment_id")
  productId    String   @map("product_id")
  batchId      String?  @map("batch_id")
  expectedQty  Decimal  @map("expected_qty") @db.Decimal(12, 2)
  actualQty    Decimal  @map("actual_qty") @db.Decimal(12, 2)
  difference   Decimal  @db.Decimal(12, 2)
  unitCost     Decimal? @map("unit_cost") @db.Decimal(12, 2)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  batch      InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
  @@map("stock_adjustment_items")
}

model StockRequest {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  requestNumber   String        @map("request_number")
  storeId         String        @map("store_id")
  requestedBy     String        @map("requested_by")
  departmentName  String        @map("department_name")
  purpose         String?
  status          RequestStatus @default(PENDING)
  approvedBy      String?       @map("approved_by")
  issuedAsIssueId String?       @map("issued_as_issue_id")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  store      Store              @relation(fields: [storeId], references: [id])
  items      StockRequestItem[]
  receivings StockReceiving[]
  tenant     Tenant             @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, requestNumber])
  @@index([organizationId])
  @@index([storeId])
  @@index([status])
  @@map("stock_requests")
}

model StockRequestItem {
  id                String   @id @default(uuid())
  requestId         String   @map("request_id")
  productId         String   @map("product_id")
  quantityRequested Decimal  @map("quantity_requested") @db.Decimal(12, 2)
  quantityApproved  Decimal? @map("quantity_approved") @db.Decimal(12, 2)
  quantityIssued    Decimal? @map("quantity_issued") @db.Decimal(12, 2)
  notes             String?

  request StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([requestId])
  @@index([productId])
  @@map("stock_request_items")
}

model PhysicalStockCount {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  countNumber    String   @map("count_number")
  storeId        String   @map("store_id")
  countType      String   @map("count_type")
  countedBy      String   @map("counted_by")
  verifiedBy     String?  @map("verified_by")
  status         String   @default("IN_PROGRESS")
  notes          String?
  countDate      DateTime @default(now()) @map("count_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store  Store                    @relation(fields: [storeId], references: [id])
  items  PhysicalStockCountItem[]
  tenant Tenant                   @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, countNumber])
  @@index([organizationId])
  @@index([storeId])
  @@map("physical_stock_counts")
}

model PhysicalStockCountItem {
  id        String  @id @default(uuid())
  countId   String  @map("count_id")
  productId String  @map("product_id")
  systemQty Decimal @map("system_qty") @db.Decimal(12, 2)
  actualQty Decimal @map("actual_qty") @db.Decimal(12, 2)
  variance  Decimal @db.Decimal(12, 2)
  notes     String?

  count   PhysicalStockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  product Product            @relation(fields: [productId], references: [id])

  @@index([countId])
  @@index([productId])
  @@map("physical_stock_count_items")
}

model Disposal {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  disposalNumber String   @map("disposal_number")
  storeId        String   @map("store_id")
  disposedBy     String   @map("disposed_by")
  approvedBy     String?  @map("approved_by")
  reason         String
  disposalMethod String?  @map("disposal_method")
  notes          String?
  disposalDate   DateTime @default(now()) @map("disposal_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store  Store          @relation(fields: [storeId], references: [id])
  items  DisposalItem[]
  tenant Tenant         @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, disposalNumber])
  @@index([organizationId])
  @@index([storeId])
  @@map("disposals")
}

model DisposalItem {
  id         String   @id @default(uuid())
  disposalId String   @map("disposal_id")
  productId  String   @map("product_id")
  batchId    String?  @map("batch_id")
  quantity   Decimal  @db.Decimal(12, 2)
  unitCost   Decimal? @map("unit_cost") @db.Decimal(12, 2)

  disposal Disposal        @relation(fields: [disposalId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  batch    InventoryBatch? @relation(fields: [batchId], references: [id])

  @@index([disposalId])
  @@index([productId])
  @@map("disposal_items")
}

model Attachment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  referenceType  String   @map("reference_type")
  referenceId    String   @map("reference_id")
  fileName       String   @map("file_name")
  fileUrl        String   @map("file_url")
  fileType       String?  @map("file_type")
  fileSize       Int?     @map("file_size")
  uploadedBy     String   @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [organizationId], references: [organizationId])

  @@index([organizationId])
  @@index([referenceType, referenceId])
  @@map("attachments")
}

model Setting {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String
  value          String
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [organizationId], references: [organizationId])

  @@unique([organizationId, key])
  @@map("settings")
}

model ActivityLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [organizationId], references: [organizationId])

  @@index([organizationId])
  @@map("activity_logs")
}
