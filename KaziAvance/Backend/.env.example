DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kazi_avance_db
JWT_ACCESS_SECRET="replace-with-shared-iam-secret"
# IMPORTANT: Must be identical to Authentication/Backend JWT_ACCESS_SECRET or session checks return 401.
MODULE_SLUG="kaziavance"
# Must match IAM MODULE_PROVISIONING_KEY / PLATFORM_SERVICE_KEY
SERVICE_API_KEY="dev-service-key"
ENABLE_LOCAL_LOGIN="false"
PORT=4400
UPLOAD_DIR="uploads"
CORS_ORIGIN=http://localhost:4401,http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:4401

# Cross-module APIs (Kazi employee directory, salary, eligibility)
IAM_API_URL=http://localhost:3001/api/v1
HR_API_URL=http://localhost:3005/api
PAYROLL_API_URL=http://localhost:3026/api
PAYROLL_API_KEY=dev-service-key
TIMETABLE_API_URL=http://localhost:3010/api
STUDENT_MANAGEMENT_API_URL=http://localhost:3052/api
ACADEMIC_API_URL=http://localhost:3003/api
ATTENDANCE_API_URL=http://localhost:3024/api
TEACHER_PORTAL_URL=http://localhost:4000/api

