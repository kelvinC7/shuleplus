NODE_ENV=development
PORT=3030
API_PREFIX=/api
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sample_module_db
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
# Must match IAM PLATFORM_SERVICE_KEY / MODULE_PROVISIONING_KEY
PLATFORM_SERVICE_KEY=dev-service-key
SERVICE_API_KEY=dev-service-key
# Authentication / IAM API (production: http://localhost:4001/api/v1)
IAM_API_URL=http://localhost:3001/api/v1
# Cross-module integration: InventoryMIS item catalogue for Excel imports
INVENTORY_API_URL=http://localhost:4011/api
INVENTORY_SERVICE_KEY=dev-service-key
CORS_ORIGIN=http://localhost:3031
# Public frontend origin embedded in QR verification links
PUBLIC_APP_URL=http://localhost:3031
MODULE_SLUG=procurement-mis
